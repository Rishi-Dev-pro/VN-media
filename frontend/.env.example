# VN-Media frontend — Phase 18 environment variables
#
# Copy to `.env.local` and adjust. Nothing here is a secret.

# mock (default) — deterministic local repositories (Phases 1-17 behavior)
# api           — real HTTP repositories against the VN-Media backend
VITE_DATA_MODE=mock

# Backend base URL (matches backend PORT from backend/.env)
VITE_API_BASE_URL=http://localhost:5000
