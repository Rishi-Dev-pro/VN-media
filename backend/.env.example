# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/vn_platform

# Authentication Configuration
JWT_SECRET=your_jwt_secret_key_here_min_32_chars
JWT_EXPIRES_IN=7d

# CORS Allowed Origins (Comma-separated in production, e.g. https://app.vnplatform.com)
CORS_ORIGINS=*

# Audio Storage Configuration
MAX_AUDIO_FILE_SIZE_MB=10
AUDIO_STORAGE_PATH=storage/audio

# Retention Policy for Soft-Deleted Audio Cleanup (Days)
AUDIO_DELETED_RETENTION_DAYS=7
